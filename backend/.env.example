# International Plebeian Academy - Backend Environment Variables
# Copy this file to .env and update with your values

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=postgresql://tribunal:tribunal@localhost:5432/plebeian_academy
# For development, you can use SQLite: DATABASE_URL=sqlite:///academy.db

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Blockchain Configuration
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
POLYGON_RPC_URL=https://polygon-rpc.com
TRIBAL_COIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
FILE_VERIFICATION_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
GOVERNANCE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Blockchain Network (mainnet, testnet, ganache)
BLOCKCHAIN_NETWORK=testnet

# Redis Configuration (for Celery/Bot System)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Manus Static Core URL (for verification)
MANUS_CORE_URL=https://manus-static-core.example.com

# WebSocket Configuration
WEBSOCKET_MESSAGE_QUEUE=redis://localhost:6379/0

# Biometric Configuration (for future hardware integration)
BIOMETRIC_ENABLED=False
BIOMETRIC_TIMEOUT=30

# File Storage
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=16777216  # 16MB

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/academy.log

# Email Configuration (for notifications)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password

# Admin Configuration
ADMIN_EMAIL=admin@plebeiantribunalsa.co.za
ADMIN_USERNAME=admin

# Bot System Configuration
BOT_ENABLED=True
BOT_TASK_TIMEOUT=300
BOT_MAX_RETRIES=3

# Monitoring
PROMETHEUS_PORT=9090
ENABLE_METRICS=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# Holographic Distribution
DISTRIBUTION_ENABLED=False
REPLICATION_FACTOR=7
NODE_ID=primary-node-1
