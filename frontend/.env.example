# International Plebeian Academy - Frontend Environment Variables
# Copy this file to .env and update with your values

# Backend API URL
VITE_API_URL=http://localhost:8000
VITE_WEBSOCKET_URL=http://localhost:8000

# Blockchain Configuration
VITE_ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
VITE_POLYGON_RPC_URL=https://polygon-rpc.com
VITE_BLOCKCHAIN_NETWORK=testnet

# Smart Contract Addresses
VITE_TRIBAL_COIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_FILE_VERIFICATION_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_GOVERNANCE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Application Configuration
VITE_APP_NAME=International Plebeian Academy
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_BIOMETRIC_AUTH=false
VITE_ENABLE_BOT_SYSTEM=true
VITE_ENABLE_BLOCKCHAIN=true
VITE_ENABLE_HOLOGRAPHIC_DISTRIBUTION=false
VITE_ENABLE_WEBSOCKETS=true

# Analytics and Monitoring (optional)
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_ID=

# Debug Mode
VITE_DEBUG_MODE=true
