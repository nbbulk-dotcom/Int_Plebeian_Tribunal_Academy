{
  "name": "international-plebeian-academy-frontend",
  "version": "1.0.0",
  "description": "International Plebeian Academy - Progressive Web Application Frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "development": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": ">=18.2.0 <19.0.0",
    "react-dom": ">=18.2.0 <19.0.0",
    "react-router-dom": ">=6.20.0 <7.0.0",
    "@reduxjs/toolkit": ">=2.0.0 <3.0.0",
    "react-redux": ">=9.0.0 <10.0.0",
    "axios": ">=1.6.0 <2.0.0",
    "socket.io-client": ">=4.6.0 <5.0.0",
    "@mui/material": ">=5.15.0 <6.0.0",
    "@mui/icons-material": ">=5.15.0 <6.0.0",
    "@emotion/react": ">=11.11.0 <12.0.0",
    "@emotion/styled": ">=11.11.0 <12.0.0",
    "recharts": ">=2.10.0 <3.0.0",
    "date-fns": ">=3.0.0 <4.0.0",
    "web3": ">=4.3.0 <5.0.0",
    "ethers": ">=6.9.0 <7.0.0"
  },
  "devDependencies": {
    "@types/react": ">=18.2.0 <19.0.0",
    "@types/react-dom": ">=18.2.0 <19.0.0",
    "@typescript-eslint/eslint-plugin": ">=6.0.0 <7.0.0",
    "@typescript-eslint/parser": ">=6.0.0 <7.0.0",
    "@vitejs/plugin-react": ">=4.2.0 <5.0.0",
    "eslint": ">=8.55.0 <9.0.0",
    "eslint-plugin-react-hooks": ">=4.6.0 <5.0.0",
    "eslint-plugin-react-refresh": ">=0.4.5 <1.0.0",
    "prettier": ">=3.1.0 <4.0.0",
    "typescript": ">=5.3.0 <6.0.0",
    "vite": ">=5.0.0 <6.0.0",
    "vite-plugin-pwa": ">=0.17.0 <1.0.0",
    "vitest": ">=1.0.0 <2.0.0",
    "@vitest/coverage-v8": ">=1.0.0 <2.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "plebeian",
    "tribunal",
    "academy",
    "peace",
    "advocacy",
    "holographic",
    "distributed",
    "blockchain",
    "pwa"
  ],
  "author": "International Plebeian Academy Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nbbulk-dotcom/Int_Plebeian_Tribunal_Academy.git"
  },
  "bugs": {
    "url": "https://github.com/nbbulk-dotcom/Int_Plebeian_Tribunal_Academy/issues"
  },
  "homepage": "https://www.plebeiantribunalsa.co.za"
}
