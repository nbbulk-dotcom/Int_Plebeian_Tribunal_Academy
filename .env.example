# International Plebeian Academy - Root Environment Variables
# Copy this file to .env and update with your values
# This file contains shared environment variables for the entire system

# ============================================================================
# GLOBAL CONFIGURATION
# ============================================================================

# Environment (development, testing, production)
ENVIRONMENT=development
NODE_ENV=development
FLASK_ENV=development

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Flask Application
SECRET_KEY=change-this-secret-key-in-production
DEBUG=True

# Database
DATABASE_URL=postgresql://tribunal:tribunal@database:5432/plebeian_academy
# For SQLite: DATABASE_URL=sqlite:///academy.db

# JWT Authentication
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend Server
FRONTEND_PORT=5173

# Backend API URL (for frontend to connect)
VITE_API_URL=http://localhost:8000
VITE_WEBSOCKET_URL=http://localhost:8000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL
POSTGRES_USER=tribunal
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=plebeian_academy
POSTGRES_PORT=5432

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery (for Bot System)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================================================
# BLOCKCHAIN CONFIGURATION
# ============================================================================

# Ethereum/Polygon Network
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
POLYGON_RPC_URL=https://polygon-rpc.com
BLOCKCHAIN_NETWORK=testnet

# Smart Contract Addresses
TRIBAL_COIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
FILE_VERIFICATION_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
GOVERNANCE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ============================================================================
# MANUS STATIC CORE CONFIGURATION
# ============================================================================

# Manus Static Core URL (for holographic verification)
MANUS_CORE_URL=https://manus-static-core.example.com
MANUS_VERIFICATION_ENABLED=True
MANUS_VERIFICATION_INTERVAL_SECONDS=3600

# ============================================================================
# BIOMETRIC CONFIGURATION
# ============================================================================

BIOMETRIC_ENABLED=False
BIOMETRIC_TIMEOUT=30

# ============================================================================
# BOT SYSTEM CONFIGURATION
# ============================================================================

BOT_ENABLED=True
BOT_TASK_TIMEOUT=300
BOT_MAX_RETRIES=3

# ============================================================================
# HOLOGRAPHIC DISTRIBUTION CONFIGURATION
# ============================================================================

DISTRIBUTION_ENABLED=False
REPLICATION_FACTOR=7
NODE_ID=primary-node-1
HOLOGRAPHIC_ENGINE_ENABLED=False

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=./logs/academy.log

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@plebeiantribunalsa.co.za

# ============================================================================
# ADMIN CONFIGURATION
# ============================================================================

ADMIN_EMAIL=admin@plebeiantribunalsa.co.za
ADMIN_USERNAME=admin

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================

PROMETHEUS_PORT=9090
ENABLE_METRICS=True

# ============================================================================
# FILE STORAGE CONFIGURATION
# ============================================================================

UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=16777216

# ============================================================================
# WEBSOCKET CONFIGURATION
# ============================================================================

WEBSOCKET_MESSAGE_QUEUE=redis://redis:6379/0
